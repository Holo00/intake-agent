# Copy to .env.local and fill in. Never commit .env.local.
#
# The app parses this once at boot and refuses to start if a selected provider
# is missing its credential — see src/lib/config.ts.

# stub   — canned responses, no API key, no network. The default.
# gemini — live extraction. Requires GEMINI_API_KEY below.
LLM_PROVIDER=stub

# https://aistudio.google.com/apikey — free tier is sufficient for this demo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Wall-clock ceiling for the whole loop, not per attempt.
EXTRACTION_TIMEOUT_MS=45000

# Attempts including the first. 2 = one initial pass plus one correction.
MAX_ATTEMPTS=2

MAX_UPLOAD_BYTES=10485760

# Optional: USD per million tokens. Verify against current provider pricing —
# these are configuration, not values this repo asserts. Set both or neither.
COST_INPUT_PER_MTOK=
COST_OUTPUT_PER_MTOK=

# Transient-failure retry (429/503), separate from the agent loop.
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_BASE_MS=500
